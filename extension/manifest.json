{
  "manifest_version": 3,
  "name": "LeetCode Auto Archive",
  "version": "1.0.0",
  "description": "Automatically archives new LeetCode submissions to GitHub with a Gemini explanation.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}